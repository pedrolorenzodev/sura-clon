{
  "permissions": {
    "deny": [
      "Edit(/app/globals.css)",
      "Edit(/app/layout.tsx)",
      "Edit(/app/not-found.tsx)",
      "Edit(/app/fonts/**)",
      "Edit(/app/styleguide/**)",
      "Edit(/components/ui/**)",
      "Edit(/components/styleguide/**)",
      "Edit(/public/**)",
      "Edit(/scripts/**)",
      "Edit(/next.config.ts)",
      "Edit(/postcss.config.mjs)",
      "Edit(/components.json)",
      "Edit(/playwright.config.ts)",
      "Edit(/tests/visual/visual.spec.ts)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git tag *)",
      "Bash(git stash *)",
      "Bash(git cherry-pick *)",
      "Bash(git worktree *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-frozen.sh" }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-frozen.sh" }
        ]
      }
    ]
  }
}
